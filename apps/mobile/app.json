{
  "expo": {
    "name": "FieldOps",
    "slug": "fieldops",
    "owner": "himanshu_bansal8000",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldops",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.fieldops.app"
    },
    "android": {
      "package": "com.fieldops.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "FieldOps",
      "shortName": "FieldOps",
      "lang": "en",
      "themeColor": "#0b1730",
      "backgroundColor": "#f4f6f9",
      "description": "FieldOps for salespeople: visits, reports and follow-ups."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FieldOps uses your location to record check-in and check-out at client visits."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FieldOps lets you attach photos from your library to visit reports.",
          "cameraPermission": "FieldOps uses the camera to capture photos for visit reports.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b89e46ea-aa20-447a-8de3-1b5343aee168"
      }
    }
  }
}
