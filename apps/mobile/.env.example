# Copy to apps/mobile/.env and fill in.
# These values identify the Firebase project and are public app configuration, not privileged
# credentials. Authorization is enforced by Firestore Rules. Never put a service-account key or
# Admin SDK credential in the mobile app.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Single-organization deployment: the organization document ID created during bootstrap.
EXPO_PUBLIC_FIELDOPS_ORG_ID=

# Set to "true" only for local emulator development. Keep "false" for production builds.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false

# LAN IP of the computer running the emulators (a phone cannot reach "localhost" on the PC).
EXPO_PUBLIC_EMULATOR_HOST=
