{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.12.0",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_FIELDOPS_ORG_ID": "main",
        "EXPO_PUBLIC_USE_FIREBASE_EMULATORS": "false"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "android": { "buildType": "app-bundle" }
    }
  }
}
