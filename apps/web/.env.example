# Copy to apps/web/.env.local and fill in from:
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration (Config)
# These values identify the project; they are NOT secrets. Access is protected by Security Rules.
# NEVER place a service-account key or any Admin SDK credential in this file.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Single-organization deployment: the organization document ID created during bootstrap.
NEXT_PUBLIC_FIELDOPS_ORG_ID=

# Set to "true" only for local emulator development. Keep "false" for production builds.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
